# Copy to .env.local (or run: npm run env:init -- <your-postgres-password>). NEVER commit .env.local
#
# Option 1: one connection string.  If the password has special characters (@ # / : ? %), URL-encode it
#           (@ -> %40, # -> %23, / -> %2F)  -- or just use Option 2.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/autoparts

# Option 2: separate fields (no encoding needed). If any DB_* variable is set, it takes priority over DATABASE_URL.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your password here
# DB_NAME=autoparts

JWT_SECRET=change-me-to-a-long-random-string
# transformers = real semantic model (Xenova/all-MiniLM-L6-v2, downloaded on first run)
# hash         = offline lightweight fallback (no download, weaker semantics)
EMBEDDING_PROVIDER=transformers
# minimum cosine similarity for a part to appear in semantic results
MIN_SIMILARITY=0.30
# password given to the demo users created by db:seed
SEED_PASSWORD=Passw0rd!
