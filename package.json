{
  "name": "autoparts-sourcing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-Brand Auto Parts Compatibility & Sourcing System (PostgreSQL + pgvector + Next.js)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:setup": "node --env-file=.env.local scripts/setup-db.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "db:reset": "npm run db:setup && npm run db:seed",
    "test": "node --env-file=.env.local --test tests/*.test.mjs"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "14.2.18",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
